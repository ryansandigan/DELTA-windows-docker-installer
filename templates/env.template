# =============================================================================
# DELTA (Docker) - installation configuration
#
# Generated by setup.ps1 into <InstallRoot>\.env. This file is read twice:
# by Docker Compose, to interpolate ${...} in docker-compose.yml, and by the
# delta container itself through env_file.
#
# It holds every secret in the installation. Its permissions are restricted to
# Administrators and SYSTEM, and it is never committed to source control.
#
# Hand edits are preserved: setup.ps1 updates individual keys in place and
# keeps comments, ordering and anything it does not own. Values marked
# __GENERATE__ are replaced with a cryptographically random value the first
# time setup.ps1 runs, and are never regenerated afterwards - regenerating
# SESSION_SECRET would sign every user out, and regenerating
# POSTGRES_PASSWORD would break authentication against a cluster that was
# already initialised with the old one.
# =============================================================================

# --- Compose project ---------------------------------------------------------
# Every docker/compose command this installer runs is scoped to this project.
COMPOSE_PROJECT_NAME="delta"

# --- Images ------------------------------------------------------------------
# DELTA_IMAGE is rewritten to a digest (…@sha256:…) after the first successful
# pull, so a restart, repair or reboot can never silently pull a new image and
# migrate the schema. DELTA_IMAGE_TAG is kept alongside it for display and for
# update checks.
DELTA_IMAGE="ghcr.io/preventionweb/delta-country:prod-latest"
DELTA_IMAGE_TAG="prod-latest"
DB_IMAGE="postgis/postgis:17-3.5"
NGINX_IMAGE="nginx:1.29-alpine"

# --- Storage -----------------------------------------------------------------
# The PostgreSQL data directory lives in a Docker-managed named volume, not
# under the installation root: it measured ~42% more throughput than a Windows
# bind mount, its fsync semantics are not translated, and antivirus and
# indexing cannot reach it. The portable recovery artefact is a pg_dump file in
# backups\, never the raw data directory.
PGDATA_VOLUME="delta_pgdata"

# --- Host ports and TLS ------------------------------------------------------
# The only ports published to Windows. Ports 3000 (DELTA) and 5432 (PostgreSQL)
# are deliberately never published. HTTPS_PORT is published only when
# TLS_ENABLED is true.
#
# TLS_MODE records how the certificate was obtained: none, supplied (operator's
# own certificate) or self-signed. The certificate itself always lives in
# certs\delta.crt with its key in certs\delta.key, mounted read-only.
HTTP_PORT="80"
HTTPS_PORT="443"
TLS_ENABLED="false"
TLS_MODE="none"

# Hostname this installation is reached by. It becomes the NGINX server_name
# and the host part of PUBLIC_URL.
DELTA_HOSTNAME="localhost"

# --- Database ----------------------------------------------------------------
# POSTGRES_PASSWORD applies only at first initialisation of the data volume.
# Changing it here afterwards changes what DELTA presents, not what the cluster
# expects: the correct fix is ALTER ROLE plus this file, never deleting the
# volume.
POSTGRES_USER="delta"
POSTGRES_DB="delta"
POSTGRES_PASSWORD="__GENERATE__"

# Defined as a separate key from day one so a least-privileged application role
# can be introduced later as a configuration change rather than a migration.
# Initially the same value as POSTGRES_PASSWORD.
DELTA_DB_PASSWORD="__GENERATE__"

# Assembled by setup.ps1 from the values above. The host is the Compose service
# name; the database is never reachable from Windows.
DATABASE_URL="__GENERATE__"

# --- Application -------------------------------------------------------------
SESSION_SECRET="__GENERATE__"
NODE_ENV="production"
LOG_DIR="/delta/logs"
LOG_LEVEL="info"
LOG_RETENTION_DAYS="30"

# --- Required application configuration --------------------------------------
# DELTA validates these three on every page load and shows a "System
# configuration errors" page when any is missing. They are required to be
# PRESENT, which is not the same as the runtime having a fallback for them:
# _configAuthSupported() defaults to "form" internally, and the validator still
# reports AUTHENTICATION_SUPPORTED as missing when it is not set. So they are
# set here explicitly, with values that make a fresh installation work without
# any further configuration.
#
# AUTHENTICATION_SUPPORTED - how people sign in. Comma-separated, and the only
# values DELTA accepts are "form" and "sso_azure_b2c". "form" is normal local
# authentication with an email and password. Choosing sso_azure_b2c
# additionally requires SSO_AZURE_B2C_TENANT, _CLIENT_ID and _CLIENT_SECRET.
AUTHENTICATION_SUPPORTED="form"

# EMAIL_TRANSPORT - "file" or "smtp", and nothing else (DELTA raises "Invalid
# EMAIL_TRANSPORT value" for anything it does not recognise). "file" writes mail
# to the container log instead of sending it, which is why a fresh installation
# needs no mail server: DELTA is fully usable on this setting.
#
# Setting it to "smtp" makes SMTP_HOST, SMTP_PORT, SMTP_USER and SMTP_PASS ALL
# required - DELTA reports each missing one as a configuration error. Use the
# management utility (option 5) rather than editing this by hand; it collects
# every value that becomes mandatory and verifies the result.
EMAIL_TRANSPORT="file"

# EMAIL_FROM - the sender address. DELTA requires it to contain both an "@" and
# a "." and reports "Email sender address appears to be invalid" otherwise.
# Filled in from the configured hostname on first run; nothing is sent from it
# while EMAIL_TRANSPORT is "file".
EMAIL_FROM="__GENERATE__"

# Public address of this installation. Standard ports are omitted, non-standard
# ports are included.
PUBLIC_URL="http://localhost"
