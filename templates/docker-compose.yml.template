# =============================================================================
# DELTA (Docker) - Compose stack
#
# Generated by setup.ps1 into <InstallRoot>\docker-compose.yml. Regenerate it
# by running setup.ps1 again; hand edits are overwritten.
#
# Every ${VALUE} below is interpolated by Docker Compose from the .env file
# next to this one, so ports, images and credentials are configuration, not
# code.
#
# Three services, one private network, one published service. Ports 3000 and
# 5432 are never published to Windows: NGINX reaches DELTA over the Compose
# network, and the installer reaches PostgreSQL through `docker compose exec`.
# =============================================================================

services:

  # ---------------------------------------------------------------------------
  # PostgreSQL 17 + PostGIS.
  #
  # The image's own init script creates the postgis and fuzzystrmatch
  # extensions in POSTGRES_DB at first initialisation, as superuser, before
  # DELTA ever connects - which is why the application's own
  # CREATE EXTENSION IF NOT EXISTS postgis is a no-op rather than a permission
  # problem.
  #
  # The data directory must be mounted at /var/lib/postgresql/data, not at
  # /var/lib/postgresql: the latter does not survive container recreation.
  # ---------------------------------------------------------------------------
  db:
    image: ${DB_IMAGE}
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
      POSTGRES_DB: ${POSTGRES_DB}
    volumes:
      - delta_pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  # ---------------------------------------------------------------------------
  # The DELTA application.
  #
  # Its CMD is never overridden: the image initialises or migrates its own
  # schema on every start, and that command *is* the migration mechanism.
  # Because of that, depends_on: service_healthy is not cosmetic - without it
  # the container starts against an absent database, fails, and Docker's
  # exponential backoff turns a 13-second recovery into a multi-minute one.
  #
  # /delta itself is never mounted over: that would hide the application baked
  # into the image. Only uploads and logs are bind-mounted, at the exact paths
  # the application hard-codes.
  #
  # The healthcheck uses Node's global fetch because the image ships neither
  # curl nor wget, and there is no /health endpoint - a plain GET / expecting
  # 200 is the honest probe. start_period covers a cold first initialisation,
  # which loads the full schema and takes around 90 seconds.
  # ---------------------------------------------------------------------------
  delta:
    image: ${DELTA_IMAGE}
    restart: unless-stopped
    depends_on:
      db:
        condition: service_healthy
    env_file:
      - .env
    environment:
      NODE_ENV: production
      LOG_DIR: /delta/logs
      DATABASE_URL: ${DATABASE_URL}
      PUBLIC_URL: ${PUBLIC_URL}
      SESSION_SECRET: ${SESSION_SECRET}
    volumes:
      - ./uploads:/delta/uploads
      - ./logs/delta:/delta/logs
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:3000/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 15s
      timeout: 10s
      retries: 10
      start_period: 180s
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

  # ---------------------------------------------------------------------------
  # NGINX - the only service with a published port.
  #
  # conf.d and certs are mounted read-only. /var/log/nginx is mounted so the
  # operator has a durable Windows-side access log; that mount replaces the
  # image's access.log -> stdout symlink, which is why the generated
  # configuration sends error_log to stderr explicitly - failures must still
  # appear in `docker compose logs nginx`.
  # ---------------------------------------------------------------------------
  nginx:
    image: ${NGINX_IMAGE}
    restart: unless-stopped
    depends_on:
      delta:
        condition: service_healthy
    ports:
      - "${HTTP_PORT}:80"
    volumes:
      - ./nginx/conf.d:/etc/nginx/conf.d:ro
      - ./certs:/etc/nginx/certs:ro
      - ./logs/nginx:/var/log/nginx
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1"]
      interval: 15s
      timeout: 10s
      retries: 5
      start_period: 30s
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "5"

volumes:
  # Docker-managed, and named explicitly rather than being prefixed with the
  # project name, so the volume an operator sees in `docker volume ls` is the
  # one recorded in .delta-install.json.
  delta_pgdata:
    name: ${PGDATA_VOLUME}
