# =============================================================================
# DELTA - NGINX reverse proxy
#
# Generated by setup.ps1 into <InstallRoot>\nginx\conf.d\delta.conf and mounted
# read-only into the nginx container. Regenerate it by running setup.ps1 again;
# hand edits are overwritten.
#
# This file is included from the stock image's http { } block, so directives at
# the top level here apply to the whole http context.
#
# The #__IF_TLS__ / #__IF_NO_TLS__ regions are selected by the installer when
# it renders this template: exactly one of them survives into the generated
# file, and the marker lines themselves never do.
# =============================================================================

# The access log goes to the bind-mounted file, so the operator has a durable
# request log they can read from Windows. Errors go to stderr so they still
# appear in `docker compose logs nginx` - mounting /var/log/nginx replaces the
# image's own stdout/stderr symlinks, and losing error output to a file nobody
# tails is how a broken upstream becomes invisible.
error_log /dev/stderr warn;

#__IF_NO_TLS__
# ---------------------------------------------------------------------------
# HTTP only.
# ---------------------------------------------------------------------------
server {
    listen      80 default_server;
    server_name __DELTA_SERVER_NAME__;

    access_log /var/log/nginx/access.log main;

    # NGINX defaults to 1 MB. DELTA accepts uploads up to 10 MB, and 50 MB on
    # one path, so without this uploads fail with HTTP 413 well before the
    # application ever sees them.
    client_max_body_size 64m;

    location / {
        # The Compose service name, never localhost: nginx and delta are
        # separate containers and resolve each other through Compose's DNS.
        proxy_pass http://delta:3000;

        # Required for keep-alive and WebSocket upgrades to the backend.
        proxy_http_version 1.1;

        # DELTA reads these headers directly rather than relying on a framework
        # "trust proxy" setting, so they are not optional decoration.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        # Long uploads and report generation outlive the 60-second default.
        proxy_read_timeout 300s;
    }
}
#__END_NO_TLS__

#__IF_TLS__
# ---------------------------------------------------------------------------
# HTTP: redirect everything to HTTPS.
#
# The redirect target keeps $host so it works for a hostname or a bare IP, and
# carries the configured HTTPS port - which the installer omits when it is 443
# and includes when it is not, through the one URL helper that decides that
# everywhere.
# ---------------------------------------------------------------------------
server {
    listen      80 default_server;
    server_name __DELTA_SERVER_NAME__;

    access_log /var/log/nginx/access.log main;

    return 301 __DELTA_HTTPS_REDIRECT_PREFIX__$request_uri;
}

# ---------------------------------------------------------------------------
# HTTPS: terminate TLS and proxy to DELTA.
#
# The certificate and key come from the read-only certs mount, never from a
# path on the Windows host and never from the Windows certificate store.
# ---------------------------------------------------------------------------
server {
    listen      443 ssl default_server;
    server_name __DELTA_SERVER_NAME__;

    ssl_certificate     __DELTA_CERT_FILE__;
    ssl_certificate_key __DELTA_KEY_FILE__;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1d;

    access_log /var/log/nginx/access.log main;

    client_max_body_size 64m;

    location / {
        proxy_pass http://delta:3000;

        proxy_http_version 1.1;

        # X-Forwarded-Proto is https here, which is what lets DELTA's Secure
        # session cookies survive the proxy hop.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_read_timeout 300s;
    }
}
#__END_TLS__
